<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Gerçekten var olan dosya, resim veya klasörleri muaf tut
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 2. search.html dosyasının kendisini sonsuz döngüden koru
    RewriteRule ^search\.html$ - [L]

    # 3. /search?q=HERHANGI_BIR_SEY adresini /HERHANGI_BIR_SEY.html adresine yönlendir (301)
    RewriteCond %{THE_REQUEST} \s/search(?:\.html)?\?q=([^\s&]+)\s [NC]
    RewriteRule ^ %1.html? [R=301,L]

    # 4. /HERHANGI_BIR_SEY.html çağrıldığında arka planda search.html?q=HERHANGI_BIR_SEY çalıştır
    RewriteRule ^([^/]+)\.html$ search.html?q=$1 [L,QSA]
</IfModule>
